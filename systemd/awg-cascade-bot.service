[Unit]
Description=AWG Cascade Multi — Telegram bot
After=network-online.target awg-cascade-watchdog.service
Requires=awg-cascade-recover.service
After=awg-cascade-recover.service
Wants=network-online.target
OnFailure=awg-cascade-alert@%n.service

[Service]
Type=simple
User=awgbot
Group=awgbot
WorkingDirectory=/opt/awg-cascade-bot
ExecCondition=/usr/local/sbin/awg-cascade-bot-enabled.sh
ExecStart=/opt/awg-cascade-bot/venv/bin/python /opt/awg-cascade-bot/bot.py
Restart=always
RestartSec=5

# Логи в journald
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
